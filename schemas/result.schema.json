{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auto-qa.local/schemas/result.schema.json",
  "title": "Semantic QA run result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "specId", "environment", "classification", "startedAt", "completedAt", "steps"],
  "properties": {
    "version": { "const": 1 },
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9]{8}_[0-9]{6}(?:_[a-z0-9]+)?$"
    },
    "specId": { "$ref": "#/$defs/id" },
    "environment": { "$ref": "#/$defs/id" },
    "classification": {
      "enum": ["passed", "healed", "functional_regression", "design_regression", "blocked"]
    },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "completedAt": { "$ref": "#/$defs/timestamp" },
    "explanation": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/stepResult" }
    },
    "fixtures": {
      "type": "array",
      "items": { "$ref": "#/$defs/fixtureResult" }
    },
    "evidence": { "$ref": "#/$defs/evidence" },
    "design": { "$ref": "#/$defs/designResult" },
    "execution": { "$ref": "#/$defs/execution" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/executionEvent" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "status": { "enum": ["passed", "failed", "blocked", "skipped"] },
    "channel": {
      "enum": ["web", "chat", "voice", "workflow", "api"]
    },
    "expectationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation", "status"],
      "properties": {
        "expectation": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "observation": { "type": "string", "minLength": 1 }
      }
    },
    "selectedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "healing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "outcome", "originalFailure", "replacement", "verification"],
      "properties": {
        "strategy": { "enum": ["target_rediscovery", "readiness_wait"] },
        "outcome": { "enum": ["healed", "failed", "blocked"] },
        "originalFailure": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 },
        "beforeScreenshot": { "$ref": "#/$defs/screenshotPath" },
        "afterScreenshot": { "$ref": "#/$defs/screenshotPath" }
      }
    },
    "stepResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "intent", "status", "expectations"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "intent": { "type": "string", "minLength": 1 },
        "channel": { "$ref": "#/$defs/channel" },
        "status": { "$ref": "#/$defs/status" },
        "expectations": {
          "type": "array",
          "items": { "$ref": "#/$defs/expectationResult" }
        },
        "selectedTarget": { "$ref": "#/$defs/selectedTarget" },
        "healing": { "$ref": "#/$defs/healing" }
      }
    },
    "fixtureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "phase", "status"],
      "properties": {
        "fixtureId": { "$ref": "#/$defs/id" },
        "phase": { "enum": ["before", "between", "after"] },
        "status": { "$ref": "#/$defs/status" },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/screenshotPath" }
        },
        "consoleErrors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "networkErrors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unsupported": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "executionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "type"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "at": { "$ref": "#/$defs/timestamp" },
        "type": {
          "enum": [
            "run_started",
            "environment_ready",
            "capability_notice",
            "fixture_started",
            "fixture_completed",
            "step_started",
            "step_completed",
            "healing_started",
            "healing_completed",
            "design_started",
            "design_completed",
            "screenshot_captured",
            "cleanup_started",
            "cleanup_completed",
            "playwright_started",
            "playwright_completed",
            "playwright_validation_started",
            "playwright_validation_completed",
            "agent_fallback_started",
            "agent_fallback_completed",
            "run_completed"
          ]
        },
        "status": { "$ref": "#/$defs/status" },
        "phase": { "enum": ["environment", "before", "between", "test", "design", "after", "run"] },
        "fixtureId": { "$ref": "#/$defs/id" },
        "stepIndex": { "type": "integer", "minimum": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "attempts", "agentCalls"],
      "properties": {
        "mode": { "enum": ["playwright", "hybrid", "agent_fallback", "agent"] },
        "agentCalls": { "type": "integer", "minimum": 0 },
        "fallbackReason": { "type": "string", "minLength": 1 },
        "script": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "state", "sourceHash", "scriptHash", "validationRuns"],
          "properties": {
            "path": { "type": "string", "pattern": "^\\.qa/specs/[a-z][a-z0-9-]*\\.playwright\\.mjs$" },
            "state": { "enum": ["missing", "candidate", "trusted", "rejected", "stale", "edited"] },
            "sourceHash": { "$ref": "#/$defs/hash" },
            "scriptHash": { "$ref": "#/$defs/hash" },
            "validationRuns": { "type": "integer", "minimum": 0 }
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["engine", "status", "startedAt", "completedAt", "durationMs"],
            "properties": {
              "engine": { "enum": ["playwright", "agent"] },
              "status": { "enum": ["passed", "failed", "blocked", "skipped"] },
              "startedAt": { "$ref": "#/$defs/timestamp" },
              "completedAt": { "$ref": "#/$defs/timestamp" },
              "durationMs": { "type": "integer", "minimum": 0 },
              "reason": { "type": "string", "minLength": 1 },
              "browserChannel": { "type": "string", "minLength": 1 },
              "validation": { "type": "boolean" },
              "consoleErrors": { "type": "array", "items": { "type": "string" } },
              "networkErrors": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "screenshotPath": {
      "type": "string",
      "pattern": "^screenshots/[a-z0-9][a-z0-9-]*\\.(?:png|jpe?g|webp)$"
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "designResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "referenceKind", "viewport", "afterStep", "status", "explanation"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "referenceKind": { "enum": ["unresolved", "image", "url", "figma"] },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
            "height": { "type": "integer", "minimum": 320, "maximum": 7680 }
          }
        },
        "afterStep": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["matched", "regression", "not_checked"] },
        "explanation": { "type": "string", "minLength": 1 },
        "actualScreenshot": { "$ref": "#/$defs/screenshotPath" },
        "referenceScreenshot": { "$ref": "#/$defs/screenshotPath" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "status", "explanation"],
            "properties": {
              "category": {
                "enum": ["components", "content", "layout", "order", "grouping", "alignment", "style"]
              },
              "status": { "enum": ["matched", "regression", "not_checked"] },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
