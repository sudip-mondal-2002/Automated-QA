{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auto-qa.local/schemas/spec.schema.json",
  "title": "Semantic QA test specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "environment", "steps"],
  "properties": {
    "version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "environment": { "$ref": "#/$defs/id" },
    "fixtures": { "$ref": "#/$defs/fixturePlan" },
    "design": { "$ref": "#/$defs/design" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "expectation": { "type": "string", "minLength": 1 },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "expect"],
      "properties": {
        "intent": { "type": "string", "minLength": 1 },
        "expect": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/expectation" }
        }
      }
    },
    "fixturePlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "before": { "$ref": "#/$defs/idList" },
        "after": { "$ref": "#/$defs/idList" },
        "between": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["afterStep", "fixtures"],
            "properties": {
              "afterStep": { "type": "integer", "minimum": 1 },
              "fixtures": { "$ref": "#/$defs/idList" }
            }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
            "height": { "type": "integer", "minimum": 320, "maximum": 7680 }
          }
        },
        "afterStep": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
