{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auto-qa.local/schemas/plan-draft.schema.json",
  "title": "Test plan draft",
  "description": "What the Planner sub-agent hands back. The orchestrator normalizes an accepted draft into a test-plan document. Prose is the human contract; the optional assert is the machine-checkable predicate the generated test evaluates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["flows"],
  "properties": {
    "notes": {
      "type": "string",
      "maxLength": 2000,
      "description": "One or two sentences on how the plan was scoped."
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 50,
      "description": "What could not be determined from the site map. Prefer saying so over inventing page text.",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/definitions/flow" }
    }
  },
  "definitions": {
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "priority", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120, "description": "Stable snake or kebab id, e.g. checkout_happy_path." },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "category": { "enum": ["happy", "error", "edge"] },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "rationale": { "type": "string", "maxLength": 1000, "description": "Why this flow is worth testing on THIS application." },
        "pages": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 300 } },
        "preconditions": {
          "type": "array",
          "maxItems": 50,
          "description": "Use \"authenticated\" when the flow requires a signed-in session.",
          "items": { "type": "string", "maxLength": 500 }
        },
        "risks": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } },
        "requirementIds": {
          "type": "array",
          "maxItems": 100,
          "description": "PRD requirement ids this flow covers. Omit or leave empty when it covers none.",
          "items": { "type": "string", "maxLength": 120 }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/definitions/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent"],
      "properties": {
        "intent": { "type": "string", "minLength": 1, "maxLength": 500, "description": "What the user is trying to do, in their words." },
        "page": { "type": "string", "maxLength": 300, "description": "Path this step happens on, e.g. /checkout." },
        "action": { "enum": ["navigate", "click", "fill", "submit", "observe"] },
        "channel": { "enum": ["web", "chat", "voice", "workflow", "api"] },
        "inputs": {
          "type": "array",
          "maxItems": 20,
          "description": "Field values this step supplies, using the exact input name from the site map.",
          "items": { "$ref": "#/definitions/input" }
        },
        "expect": {
          "type": "array",
          "maxItems": 20,
          "description": "Omit on a pure action step; the orchestrator folds it into the step that asserts its outcome.",
          "items": { "$ref": "#/definitions/expectation" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "value": { "type": "string", "maxLength": 2000 },
        "sensitive": { "type": "boolean", "description": "True for passwords and tokens." }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prose"],
      "properties": {
        "prose": { "type": "string", "minLength": 1, "maxLength": 1000, "description": "The human-readable expectation, e.g. \"Order confirmation is visible\"." },
        "assert": { "$ref": "#/definitions/predicate" }
      }
    },
    "predicate": {
      "description": "Never copy the prose into value. The value must be text observed in the crawl, not a description of it.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": { "kind": { "enum": ["text", "absent_text", "url_contains"] }, "value": { "type": "string", "minLength": 1, "maxLength": 1000 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector"],
          "properties": { "kind": { "enum": ["visible", "absent"] }, "selector": { "type": "string", "minLength": 1, "maxLength": 1000 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "selector", "count"],
          "properties": { "kind": { "const": "count" }, "selector": { "type": "string", "minLength": 1, "maxLength": 1000 }, "count": { "type": "integer", "minimum": 0 } }
        }
      ]
    }
  }
}
