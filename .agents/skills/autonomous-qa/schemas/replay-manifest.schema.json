{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auto-qa.local/schemas/replay-manifest.schema.json",
  "title": "Playwright replay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "specId", "environment", "state", "sourceHash", "scriptHash", "generatorVersion", "coverage", "validation"],
  "properties": {
    "version": { "const": 1 },
    "specId": { "$ref": "#/$defs/id" },
    "environment": { "$ref": "#/$defs/id" },
    "state": { "enum": ["candidate", "trusted", "rejected"] },
    "sourceHash": { "$ref": "#/$defs/hash" },
    "scriptHash": { "$ref": "#/$defs/hash" },
    "generatorVersion": { "type": "string", "minLength": 1 },
    "browserChannel": { "type": "string", "minLength": 1 },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "validatedAt": { "$ref": "#/$defs/timestamp" },
    "lastFailure": { "type": "string", "minLength": 1 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "total", "complete"],
      "properties": {
        "deterministic": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "passed"],
      "properties": {
        "required": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" }
  }
}
