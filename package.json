{
  "name": "autonomous-qa-agent",
  "version": "0.5.0",
  "private": true,
  "description": "File-backed semantic QA runtime with native execution, design evidence, and a localhost workspace UI",
  "type": "module",
  "bin": {
    "qa-agent": ".agents/skills/autonomous-qa/scripts/qa-agent"
  },
  "scripts": {
    "build:skill": "node scripts/build-skill-package.mjs",
    "demo": "npm --prefix demo-app run dev --",
    "demo:corners": "node scripts/demo-corner-cases.mjs",
    "demo:reset": "npm --prefix demo-app run reset --",
    "dev": "npm --prefix demo-app run dev --",
    "ui": ".agents/skills/autonomous-qa/scripts/qa-agent ui",
    "qa-agent": ".agents/skills/autonomous-qa/scripts/qa-agent",
    "benchmark:qa:prepare": "node benchmarks/qa/prepare.mjs",
    "benchmark:qa:heal": "node benchmarks/qa/healing/run.mjs",
    "benchmark:qa:score": "node benchmarks/qa/score.mjs",
    "benchmark:qa:verify": "node benchmarks/qa/verify.mjs",
    "benchmark:webforge:prepare": "node benchmarks/web-agent/webforge/prepare.mjs",
    "benchmark:webforge:serve": "node benchmarks/web-agent/webforge/serve.mjs",
    "benchmark:webforge:record": "node benchmarks/web-agent/webforge/record.mjs",
    "benchmark:webforge:score": "node benchmarks/web-agent/webforge/score.mjs",
    "benchmark:webforge:publish": "node benchmarks/web-agent/webforge/publish.mjs",
    "benchmark:webforge:verify": "node benchmarks/web-agent/webforge/verify.mjs",
    "pretest": "npm run build:skill",
    "pretest:coverage": "npm run build:skill",
    "test": "node --test",
    "test:soak": "node scripts/replay-soak.mjs",
    "benchmark:replay": "node scripts/benchmark-replay.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=98"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.25.9"
  }
}
