{
  "name": "autonomous-qa-agent",
  "version": "0.4.0",
  "private": true,
  "description": "File-backed semantic QA runtime with native execution, self-healing, and reference-backed design evidence",
  "type": "module",
  "bin": {
    "qa-agent": ".agents/skills/autonomous-qa/scripts/qa-agent"
  },
  "scripts": {
    "demo": "node demo-app/server.js",
    "dev": "node demo-app/server.js",
    "qa-agent": "node .agents/skills/autonomous-qa/scripts/qa-agent",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=98"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
