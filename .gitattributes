# The built skill bundle is generated by esbuild (LF). Keep it stable across
# platforms so a Windows build does not show the whole file as modified.
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.md text eol=lf
.agents/skills/autonomous-qa/scripts/qa-agent text eol=lf
.agents/skills/autonomous-qa/scripts/qa-agent.cmd text eol=crlf
*.png binary
*.jpg binary
*.mp4 binary
*.m4a binary
*.mp3 binary
